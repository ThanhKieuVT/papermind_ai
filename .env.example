# Copy to .env.local for local development. Never commit real values.

# Gemini API key (server-side only). Leave empty to run with AI disabled.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-2.5-flash)
GEMINI_MODEL=

# Access token required to call AI endpoints in production.
# Users enter it in Settings; it is sent as the x-papermind-access header.
# In production, AI endpoints stay disabled unless this is set OR AI_ALLOW_PUBLIC=true.
AI_ACCESS_TOKEN=

# Set to "true" to allow unauthenticated AI usage in production (NOT recommended for public deployments).
AI_ALLOW_PUBLIC=

# Optional: e-mail sent to OpenAlex to join the "polite pool" (better rate limits).
OPENALEX_MAILTO=

# Optional but strongly recommended for deployments: free OpenAlex API key
# (https://openalex.org/settings/api). Without it, requests share a small
# per-IP daily budget, which is easily exhausted on shared hosting IPs.
OPENALEX_API_KEY=

# Visitors may unlock AI with their own Gemini key (sent per request, never stored server-side).
# Set to "false" to allow only the site key + AI_ACCESS_TOKEN.
AI_ALLOW_USER_KEYS=
